# proyubi-mcp 环境变量模板。复制为 .env（gitignore）后填写。

# Proyubi server 的地址（同一 docker 网络内用服务名，例如 http://server:38082）
PM_API_BASE_URL=http://localhost:38082

# 与 server 的 PM_INTERNAL_API_KEY（proyubi.internal-api.key）完全一致
PM_INTERNAL_API_KEY=replace-with-the-same-key-as-server

# 可选：静态令牌表（1 行 JSON）。通常不需要 —— 用户在「設定→MCP設定」里自助发行令牌。
# token 建议 32 位以上随机串；分发的 URL = https://<mcp 域名>/t/<token>/mcp
# PM_MCP_TOKENS=[{"token":"CHANGE-ME","tenantId":"00000000-0000-0000-0000-000000000000","label":"alice"}]

# 监听端口
PORT=8080
