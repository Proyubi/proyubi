<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.proyubi</groupId>
    <artifactId>proyubi-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>proyubi</name>
    <description>Proyubi — project management for teams that deliver software to clients</description>
    <url>https://github.com/Proyubi/proyubi</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
        </license>
    </licenses>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.4.2</spring-boot.version>
        <satoken.version>1.37.0</satoken.version>
        <mybatis-flex.version>1.9.8</mybatis-flex.version>
        <hutool.version>5.8.27</hutool.version>
        <lombok.version>1.18.32</lombok.version>
        <minio.version>8.5.7</minio.version>
        <flatten-maven-plugin.version>1.5.0</flatten-maven-plugin.version>
    </properties>

    <!-- 切换后改写 application.yml 的 @profiles.active@；启动时加载 application-<profile>.yml + .env.<profile> -->
    <profiles>
        <profile>
            <id>dev</id>
            <properties>
                <profiles.active>dev</profiles.active>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-bom</artifactId>
                <version>${hutool.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-spring-boot3-starter</artifactId>
                <version>${satoken.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-core</artifactId>
                <version>${satoken.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-jackson</artifactId>
                <version>${satoken.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mybatis-flex</groupId>
                <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
                <version>${mybatis-flex.version}</version>
            </dependency>
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-common-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-common-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-common-satoken</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-common-mybatis-flex</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-common-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-capabilities</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-regions</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-identity</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-platform</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>ai.proyubi</groupId>
                <artifactId>proyubi-pm</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>proyubi-common-core</module>
        <module>proyubi-common-web</module>
        <module>proyubi-common-satoken</module>
        <module>proyubi-common-mybatis-flex</module>
        <module>proyubi-common-redis</module>
        <module>proyubi-capabilities</module>
        <module>proyubi-regions</module>
        <module>proyubi-identity</module>
        <module>proyubi-platform</module>
        <module>proyubi-pm</module>
        <module>proyubi-server</module>
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-maven-plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten.clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>

        <!-- 只对 application*/banner* 做 @..@ 过滤，注入 profiles.active -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application*</exclude>
                    <exclude>banner*</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application*</include>
                    <include>banner*</include>
                </includes>
            </resource>
        </resources>
    </build>
</project>
