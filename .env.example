# docker compose 用。复制为 .env 后填写（.env 不进 git）。

# ---- 必填 ----
POSTGRES_PASSWORD=change-me
# server 与 mcp 共用的内部 API 密钥（随机 32 字节以上）
PM_INTERNAL_API_KEY=change-me
# モックアップ署名 URL 的密钥（固定值，否则重启后旧链接全部失效）
PM_MOCKUP_SIGN_SECRET=change-me
# 平台超级管理员
OPS_ADMIN_USERNAME=admin
OPS_ADMIN_PASSWORD=change-me

# ---- 对外地址（按你的域名改）----
APP_WEB_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080
PM_MOCKUP_RAW_BASE_URL=http://localhost:8080
PM_MOCKUP_WEB_BASE_URL=http://localhost:8080
PM_MOCKUP_FRAME_ANCESTORS=http://localhost:8080
PM_MCP_BASE_URL=http://localhost:3110
WEB_PORT=8080
MCP_PORT=3110

# 自托管单租户可设 SINGLE（不做租户隔离过滤）；SaaS 多租户用 MULTI
PROYUBI_TENANCY_MODE=MULTI

# ---- 可选 ----
# 邮件（验证码、邀请）。不填则只打日志。
RESEND_API_KEY=
MAIL_FROM=Proyubi <no-reply@example.com>
# Google 登录 / Google Picker
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/app/auth/oauth/google/callback
GOOGLE_OAUTH_FRONT_REDIRECT=http://localhost:8080/oauth/callback
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# Sign in with Apple（iOS Bundle ID / Services ID，逗号分隔）
APPLE_OAUTH_CLIENT_IDS=

# 既有 Docker volume 的数据库名/用户名默认保持 pullcord。
# 仅在全新数据库初始化时可自行改名；不要直接改已有数据卷的名字。
POSTGRES_DB=pullcord
POSTGRES_USER=pullcord
